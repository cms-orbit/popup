{
    "name": "cms-orbit/popup",
    "version": "4.2.0",
    "description": "CMS Orbit popup: document-based popup content type for the Orbit admin engine.",
    "keywords": [
        "laravel",
        "cms",
        "orbit",
        "popup",
        "document"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "cms-orbit/core": "^4.5",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30"
    },
    "autoload": {
        "psr-4": {
            "CmsOrbit\\Popup\\": "src/",
            "CmsOrbit\\Popup\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CmsOrbit\\Popup\\PopupServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "lock": false
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-install-cmd": [
            "git config core.hooksPath .githooks || true"
        ]
    }
}
